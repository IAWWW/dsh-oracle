{
  "name": "dsh-oracle",
  "version": "1.1.2",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "ssh.cjs",
    "exec.cjs",
    "chat.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "description": "On-demand SSH dashboard and command console for a Linux server inside DeepSeek Harness: colored status charts, a file explorer, and a dedicated chat that can inspect and change the server.",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ssh",
    "server",
    "dashboard",
    "oracle-cloud"
  ],
  "homepage": "https://github.com/IAWWW/dsh-oracle#readme",
  "bugs": {
    "url": "https://github.com/IAWWW/dsh-oracle/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IAWWW/dsh-oracle.git"
  },
  "engines": {
    "dsh": "0.2.2-rc.5"
  }
}
